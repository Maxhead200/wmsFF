{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "custom",
    "customBindHost": "172.18.0.1",
    "auth": { "mode": "token", "token": { "source": "env", "provider": "default", "id": "OPENCLAW_GATEWAY_TOKEN" } },
    "http": { "endpoints": { "chatCompletions": { "enabled": true } } },
    "controlUi": { "enabled": false }
  },
  "agents": {
    "defaults": {
      "workspace": "/var/lib/wms-openclaw/workspace",
      "model": { "primary": "openai/gpt-5.6-sol" },
      "sandbox": { "mode": "off" },
      "maxConcurrent": 2
    },
    "entries": { "wms": { "name": "WMS LOGOFF", "workspace": "/var/lib/wms-openclaw/workspace" } }
  },
  "plugins": { "entries": { "codex": { "enabled": true } } },
  "tools": {
    "profile": "full",
    "exec": { "host": "gateway", "mode": "full", "timeoutSeconds": 600, "applyPatch": { "workspaceOnly": false } }
  }
}
